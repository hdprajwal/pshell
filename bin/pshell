#!/bin/sh
#
# pshell - talk to the running shell.
#
# Every command here is one rewrite: `pshell lock` becomes
# `qs -p <checkout> ipc call pshell.lock lock`. None of the work is done
# here and none of it could be -- Quickshell's IPC socket protocol is
# internal and unversioned, so anything speaking it directly would break on
# upgrade. What this saves is knowing where the checkout lives, which is the
# only part of those commands that was ever hard to remember.
#
# One command is not that: `launcher` runs walker, because that is the one
# job pshell hands to someone else. The case block says why it is here
# rather than in the keybind.

set -eu

# ---------------------------------------------------------------- the shell

# Which shell to talk to. Three answers, in this order:
#
#   1. The checkout this script sits in, so <checkout>/bin/pshell always
#      drives its own checkout. readlink -f resolves a symlink first, so a
#      link into ~/.local/bin still reaches the copy it points at rather
#      than whichever pshell is first on PATH -- which is what makes it
#      safe to try a branch without uninstalling anything.
#
#   2. $PSHELL_DIR, for a copy installed somewhere that is not a checkout:
#      ~/.config/pshell alongside config.json, say. This is the one to set
#      if you keep your checkout somewhere of your own choosing.
#
#   3. The install path the README documents.
#
# Location beats the variable on purpose. Reaching for a specific
# checkout's copy is a more specific request than an environment set once
# in a shell rc, and the alternative -- a stale PSHELL_DIR silently
# redirecting a worktree's own command at some other tree -- is exactly the
# confusion this ordering exists to avoid.

# $0 is a bare name when the shell found us on PATH and a path otherwise,
# and readlink -f resolves the second but not the first.
case $0 in
*/*) self=$(readlink -f "$0") ;;
*) self=$(readlink -f "$(command -v -- "$0")") ;;
esac

beside=$(dirname "$(dirname "$self")")
fallback=${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/pshell

dir=""
for candidate in "$beside" "${PSHELL_DIR:-}" "$fallback"; do
    if [ -n "$candidate" ] && [ -f "$candidate/shell.qml" ]; then
        dir=$candidate
        break
    fi
done

if [ -z "$dir" ]; then
    echo "pshell: cannot find a pshell checkout." >&2
    echo "pshell: looked beside this script ($beside)," >&2
    echo "pshell: in \$PSHELL_DIR, and in $fallback" >&2
    echo "pshell:" >&2
    echo "pshell: point it at the directory holding shell.qml:" >&2
    echo "pshell:   export PSHELL_DIR=~/src/pshell" >&2
    exit 1
fi

# ------------------------------------------------------------------ display

# The display an instance of our shell is running on, or nothing.
#
# Read line at a time rather than by awk field, because a checkout path with
# a space in it is a path, not three fields.
display_of() {
    want=$1

    qs list --all 2>/dev/null | while IFS= read -r line; do
        case $line in
        *"Config path: $want")
            seen=1
            ;;
        *"Display connection: "*)
            if [ "${seen:-0}" = 1 ]; then
                printf '%s\n' "${line##*/}"
                break
            fi
            ;;
        esac
    done
}

# A TTY has no WAYLAND_DISPLAY, and `qs ipc` will not look at an instance
# running on a display it is not itself on -- it reports "No running
# instances" and lists the others as being elsewhere.
#
# That breaks the one command that has to work from a TTY. If the lockscreen
# will not take your password, a TTY is where you are, and `pshell unlock`
# is the difference between getting your session back and ending it.
#
# Done here rather than at startup so that `pshell help`, and a bad command
# line, cost nothing.
ensure_display() {
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        return 0
    fi

    found=$(display_of "$dir/shell.qml")
    if [ -n "$found" ]; then
        WAYLAND_DISPLAY=$found
        export WAYLAND_DISPLAY
    fi
}

need_qs() {
    if ! command -v qs >/dev/null 2>&1; then
        echo "pshell: qs is not on your PATH. Quickshell is what runs the shell;" >&2
        echo "pshell: pshell only tells it what to do." >&2
        exit 1
    fi
}

# The same courtesy for walker, and it needs more of it: qs is in the README's
# first paragraph, walker is a thing pshell delegates to and a user may never
# have heard of. `exec: walker: not found` after a keypress would look like
# pshell was broken rather than like something was missing, so say what to
# install and say that elephant is the half that does the searching -- walker
# without it starts and finds nothing.
need_walker() {
    if command -v walker >/dev/null 2>&1; then
        return 0
    fi

    echo "pshell: walker is not on your PATH. pshell hands the launcher to" >&2
    echo "pshell: walker rather than building its own." >&2
    echo "pshell:" >&2
    echo "pshell:   sudo pacman -S walker    # the window you type into" >&2
    echo "pshell:   yay -S elephant-all-bin  # the backend it searches" >&2
    echo "pshell:   elephant service enable && systemctl --user start elephant" >&2
    exit 1
}

# -------------------------------------------------------------------- usage

# No list of targets here. The targets belong to the QML that declares them,
# and a copy in this file would be one more thing to forget to update --
# `pshell ipc show` asks the shell itself, and cannot go stale.
#
# launcher is listed because it is not a target. No QML declares it and
# `pshell ipc show` will never mention it; this file is the only thing that
# knows it exists, so it is the only thing that can say so. clipboard is a
# target, and listed anyway: it is the other half of the pair the README
# documents together, and its bare form is a shorthand like `lock`.
# nightlight is listed for the same shorthand, and because it needs something
# installed before it can work; updates for the same two reasons. audio tone
# is listed because it is a method taking a word, which `ipc show` prints
# as a signature rather than as the four words it takes.
usage() {
    cat <<'EOF'
usage: pshell <command> [arguments]

  lock                    lock the screen
  unlock                  unlock it, for when the password will not take
  preview                 draw the lockscreen in a window, without locking
  run [qs options]        start the shell
  ipc <arguments>         pass straight through to qs ipc

  launcher                open the application launcher (walker)
  clipboard               open or close the clipboard history
  nightlight              turn the nightlight on or off (needs hyprsunset)
  updates                 pending package updates (needs cachy-update or
                          arch-update); `pshell updates open` runs them
  audio tone [on|off|toggle|test]
                          the tone after a volume change; bare, its status

  <target> <method> [..]  call any IPC target directly:
                            pshell calendar toggle
                            pshell settings open about
                            pshell lock isLocked

`pshell ipc show` lists every target the running shell has.
EOF
}

no_arguments() {
    if [ "$2" -ne 0 ]; then
        echo "pshell: $1 takes no arguments" >&2
        exit 1
    fi
}

# --------------------------------------------------------------------- call

# qs answers a shell that is not running with "No running instances", which
# reads as "you typed the command wrong" rather than "the thing you are
# talking to is down". Say the second one, and say what to do about it.
call() {
    need_qs
    ensure_display

    status=0
    out=$(qs -p "$dir" ipc call "$@" 2>&1) || status=$?

    # The exit code is not enough on its own. qs answers an unknown target
    # by printing "Target not found." and exiting 0, so a mistyped command
    # -- or a shell running a branch that does not have the target yet --
    # would otherwise look like it worked, and say so on stdout.
    case $out in
    *"No running instances"*)
        echo "pshell: the shell is not running. Start it with: pshell run" >&2
        exit 1
        ;;
    *"Target not found"*)
        echo "pshell: this shell has no '$1' target." >&2
        echo "pshell: run 'pshell ipc show' to see the ones it does have." >&2
        exit 1
        ;;
    esac

    if [ "$status" -ne 0 ]; then
        printf '%s\n' "$out" >&2
        exit 1
    fi

    # A target that cannot do what it was asked answers with a line starting
    # `error: `, since an IPC method has no exit code of its own to fail
    # with. Turned into one here, so `pshell nightlight on && ...` does not
    # carry on as if the screen had warmed.
    #
    # Only for the targets listed, which promise to answer that way. For any
    # other, output that starts `error: ` is just output: notification
    # history prints `app: summary` lines, and an app named "error" would
    # otherwise turn the whole history into a failure with nothing printed.
    #
    # pshell.updates is listed because its only free text is `list`, and
    # every line of that starts with `repo`, `aur` or `flatpak` and a tab --
    # a package called "error" cannot make it start `error: `.
    #
    # pshell.weather is listed for `hourly`, which has nothing to print
    # before the first reading. Its other answers start with a temperature,
    # a dash or an hour, and the place name is never first.
    #
    # pshell.audio is listed because `tone` answers that way, and its only
    # other free text is `status`, which starts with `volume`.
    case $1 in
    pshell.nightlight | pshell.updates | pshell.weather | pshell.audio)
        case $out in
        "error: "*)
            printf 'pshell: %s\n' "${out#error: }" >&2
            exit 1
            ;;
        esac
        ;;
    esac

    if [ -n "$out" ]; then
        printf '%s\n' "$out"
    fi
}

# ----------------------------------------------------------------- dispatch

if [ $# -eq 0 ]; then
    usage
    exit 0
fi

cmd=$1
shift

case $cmd in
-h | --help | help)
    usage
    ;;
run)
    need_qs
    exec qs -p "$dir" "$@"
    ;;
ipc)
    need_qs
    ensure_display
    exec qs -p "$dir" ipc "$@"
    ;;
lock)
    # Bare `pshell lock` locks. Anything after it is a method on the same
    # target and its arguments, so `pshell lock isLocked` still means what
    # it looks like.
    if [ $# -eq 0 ]; then
        call pshell.lock lock
    else
        call pshell.lock "$@"
    fi
    ;;
unlock)
    no_arguments unlock $#
    call pshell.lock unlock
    ;;
preview)
    no_arguments preview $#
    call pshell.lock preview
    ;;

# The next one is the only exception to everything this file says about
# itself, and it is worth being clear that neither of those claims has gone
# wrong.
#
# The comment at the top says every command is one rewrite into
# `qs ipc call`; the one above usage() says the target list belongs to the
# QML. Both hold for every other command here. launcher runs a program
# instead of talking to the shell, so it cannot go through call(): there is
# no IPC target behind it and there is not going to be one. The launcher is
# the single thing pshell decided not to build -- walker is better at fuzzy
# search than anything worth writing here.
#
# It lives in this file anyway, and in usage(), because a keybind should read
# `pshell launcher` and not name a third-party binary. That is its whole
# purpose: the day walker is swapped for something else, the bind in
# binds-user.lua does not move -- this case does.
#
# It does not forward arguments, deliberately. Forwarding walker's flags
# would put walker's command line back inside the keybind, which is the thing
# this exists to keep out of it. Anyone who wants walker's own options wants
# to type `walker`.
#
# clipboard used to be its twin, `walker --provider clipboard`. The history
# is pshell's own now (Services/Clipboard.qml), so it is an ordinary target
# again and its case is the one below the launcher's.
launcher)
    # Bare `walker`, with no provider named, and that is the whole point of
    # delegating: which providers a launcher searches is walker's decision
    # and then the user's, in `providers.default` in their own
    # ~/.config/walker/config.toml. `--provider desktopapplications` would
    # override that file -- pshell has no business fighting a config it does
    # not own -- and worse, walker skips its entire prefix table whenever a
    # provider is set exclusively (src/data.rs, the `get_provider().is_empty()
    # && ...` guard). That kills all ten prefixes at once: `=` calc, `.`
    # symbols, `@` websearch, `;` providerlist, `>` runner, `/` files, `!`
    # todo, `%` bookmarks, `:` clipboard, `$` windows. An emoji picker that
    # SUPER+D cannot reach is not an emoji picker.
    #
    # What it costs, on walker's stock defaults: a websearch row in the
    # results, and a calc row on anything that looks like arithmetic. One
    # line of the user's own config removes either. That is the right place
    # for that opinion to live, and not here.
    #
    # Which leaves `pshell launcher` as literally `walker`, so its only
    # remaining value is the indirection -- the bind says `pshell launcher`
    # and the binary is named in one place. That was always the stated
    # purpose, but it is worth admitting the command now does nothing else.
    no_arguments launcher $#
    need_walker
    exec walker
    ;;
clipboard)
    # Bare `pshell clipboard` toggles the panel, so the keybind that opens it
    # also closes it -- `lock`'s shape: anything after it is a method on the
    # same target, so `pshell clipboard history 10` still means what it
    # looks like.
    if [ $# -eq 0 ]; then
        call pshell.clipboard toggle
    else
        call pshell.clipboard "$@"
    fi
    ;;
nightlight)
    # Bare `pshell nightlight` toggles, `clipboard`'s shape, so one keybind
    # turns it on and off; anything after it is a method on the same target.
    if [ $# -eq 0 ]; then
        call pshell.nightlight toggle
    else
        call pshell.nightlight "$@"
    fi
    ;;
updates)
    # Bare `pshell updates` says where things stand rather than doing
    # anything: the one action worth a bare word here starts a sudo pacman
    # in a terminal, and that should be asked for by name -- `open`.
    # Anything after it is a method on the same target, as for the others.
    if [ $# -eq 0 ]; then
        call pshell.updates status
    else
        call pshell.updates "$@"
    fi
    ;;
audio)
    # Only to give `pshell audio tone` a bare form: the method takes its
    # action as an argument, and qs refuses a call missing one. Everything
    # else is the target dispatch below, unchanged.
    if [ $# -eq 1 ] && [ "$1" = tone ]; then
        call pshell.audio tone status
    elif [ $# -eq 0 ]; then
        echo "pshell: audio needs a method, eg. pshell audio toggleMute" >&2
        exit 1
    else
        call pshell.audio "$@"
    fi
    ;;
*)
    # Anything else is a target name, left unvalidated for the same reason
    # usage lists none: qs already answers an unknown one clearly, and this
    # file should not carry a second copy of the QML's target list.
    if [ $# -eq 0 ]; then
        echo "pshell: $cmd needs a method, eg. pshell $cmd toggle" >&2
        exit 1
    fi
    call "pshell.$cmd" "$@"
    ;;
esac
