#!/bin/sh
#
# pshell - talk to the running shell.
#
# Every command here is one rewrite: `pshell lock` becomes
# `qs -p <checkout> ipc call pshell.lock lock`. None of the work is done
# here and none of it could be -- Quickshell's IPC socket protocol is
# internal and unversioned, so anything speaking it directly would break on
# upgrade. What this saves is knowing where the checkout lives, which is the
# only part of those commands that was ever hard to remember.

set -eu

# Which shell to talk to. Three answers, in this order:
#
#   1. The checkout this script sits in, so <checkout>/bin/pshell always
#      drives its own checkout. readlink -f resolves a symlink first, so a
#      link into ~/.local/bin still reaches the copy it points at rather
#      than whichever pshell is first on PATH -- which is what makes it
#      safe to try a branch without uninstalling anything.
#
#   2. $PSHELL_DIR, for a copy installed somewhere that is not a checkout:
#      ~/.config/pshell alongside config.json, say. This is the one to set
#      if you keep your checkout somewhere of your own choosing.
#
#   3. The install path the README documents.
#
# Location beats the variable on purpose. Reaching for a specific
# checkout's copy is a more specific request than an environment set once
# in a shell rc, and the alternative -- a stale PSHELL_DIR silently
# redirecting a worktree's own command at some other tree -- is exactly the
# confusion this ordering exists to avoid.
self=$(readlink -f "$0")
beside=$(dirname "$(dirname "$self")")
fallback=${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/pshell

dir=""
for candidate in "$beside" "${PSHELL_DIR:-}" "$fallback"; do
    if [ -n "$candidate" ] && [ -f "$candidate/shell.qml" ]; then
        dir=$candidate
        break
    fi
done

if [ -z "$dir" ]; then
    echo "pshell: cannot find a pshell checkout." >&2
    echo "pshell: looked beside this script ($beside)," >&2
    echo "pshell: in \$PSHELL_DIR, and in $fallback" >&2
    echo "pshell:" >&2
    echo "pshell: point it at the directory holding shell.qml:" >&2
    echo "pshell:   export PSHELL_DIR=~/src/pshell" >&2
    exit 1
fi

# A TTY has no WAYLAND_DISPLAY, and `qs ipc` will not look at an instance
# running on a display it is not itself on -- it reports "No running
# instances" and lists the others as being elsewhere.
#
# That breaks the one command that has to work from a TTY. If the lockscreen
# will not take your password, a TTY is where you are, and `pshell unlock`
# is the difference between getting your session back and ending it.
#
# So when the variable is missing, take it from the instance list.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    found=$(qs list --all 2>/dev/null | awk -v want="$dir/shell.qml" '
        $1 == "Config" && $3 == want { seen = 1; next }
        seen && $1 == "Display" { sub(/.*\//, "", $3); print $3; exit }
    ')
    if [ -n "$found" ]; then
        WAYLAND_DISPLAY=$found
        export WAYLAND_DISPLAY
    fi
fi

usage() {
    cat <<'EOF'
usage: pshell <command> [arguments]

  lock                    lock the screen
  unlock                  unlock it, for when the password will not take
  preview                 draw the lockscreen in a window, without locking
  run [qs options]        start the shell
  ipc <arguments>         pass straight through to qs ipc

  <target> <method> [..]  call any IPC target directly:
                            pshell calendar toggle
                            pshell settings open about
                            pshell lock isLocked

targets: aiusage battery bluetooth calendar controlcenter lock network
         settings tailscale
EOF
}

# qs answers a shell that is not running with "No running instances", which
# reads as "you typed the command wrong" rather than "the thing you are
# talking to is down". Say the second one, and say what to do about it.
call() {
    if out=$(qs -p "$dir" ipc call "$@" 2>&1); then
        if [ -n "$out" ]; then
            printf '%s\n' "$out"
        fi
        return 0
    fi

    case $out in
    *"No running instances"*)
        echo "pshell: the shell is not running. Start it with: pshell run" >&2
        ;;
    *)
        printf '%s\n' "$out" >&2
        ;;
    esac
    exit 1
}

if [ $# -eq 0 ]; then
    usage
    exit 0
fi

cmd=$1
shift

case $cmd in
-h | --help | help)
    usage
    ;;
run)
    exec qs -p "$dir" "$@"
    ;;
ipc)
    exec qs -p "$dir" ipc "$@"
    ;;
lock)
    # Bare `pshell lock` locks. A method after it reaches the rest of the
    # target, so `pshell lock isLocked` still means what it looks like.
    call pshell.lock "${1:-lock}"
    ;;
unlock)
    call pshell.lock unlock
    ;;
preview)
    call pshell.lock preview
    ;;
*)
    # Anything else is a target name. Left unvalidated on purpose: the list
    # of targets belongs to the QML, not to this file, and a copy here would
    # be one more thing to forget to update. qs already answers an unknown
    # one clearly.
    if [ $# -eq 0 ]; then
        echo "pshell: $cmd needs a method, eg. pshell $cmd toggle" >&2
        exit 1
    fi
    call "pshell.$cmd" "$@"
    ;;
esac
