// Generated by pshell from the wallpaper; overwritten on every theme change.
{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "pshell",
  "author": "pshell",
  "themes": [
    {
      "name": "pshell",
      "appearance": "{{mode}}",
      "style": {
        "background.appearance": "opaque",
        "background": "{{colors.surface.default.hex}}",
        "surface.background": "{{colors.surface.default.hex}}",
        "elevated_surface.background": "{{colors.surface_container.default.hex}}",
        "border": "{{colors.outline_variant.default.hex}}",
        "border.variant": "{{colors.outline_variant.default.hex}}",
        "border.focused": "{{colors.primary.default.hex}}",
        "border.selected": "{{colors.primary.default.hex}}",
        "border.disabled": "{{colors.outline_variant.default.hex}}",
        "element.background": "{{colors.surface_container.default.hex}}",
        "element.hover": "{{colors.surface_container_high.default.hex}}",
        "element.active": "{{colors.surface_container_highest.default.hex}}",
        "element.selected": "{{colors.primary_container.default.hex}}",
        "ghost_element.hover": "{{colors.surface_container.default.hex}}",
        "ghost_element.active": "{{colors.surface_container_high.default.hex}}",
        "ghost_element.selected": "{{colors.primary_container.default.hex}}",
        "drop_target.background": "{{colors.primary_container.default.hex}}",
        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "text.placeholder": "{{colors.outline.default.hex}}",
        "text.disabled": "{{colors.outline.default.hex}}",
        "text.accent": "{{colors.primary.default.hex}}",
        "icon": "{{colors.on_surface.default.hex}}",
        "icon.muted": "{{colors.on_surface_variant.default.hex}}",
        "icon.accent": "{{colors.primary.default.hex}}",
        "status_bar.background": "{{colors.surface.default.hex}}",
        "title_bar.background": "{{colors.surface.default.hex}}",
        "toolbar.background": "{{colors.surface.default.hex}}",
        "tab_bar.background": "{{colors.surface.default.hex}}",
        "tab.inactive_background": "{{colors.surface.default.hex}}",
        "tab.active_background": "{{colors.surface_container.default.hex}}",
        "panel.background": "{{colors.surface.default.hex}}",
        "scrollbar.thumb.background": "{{colors.outline.default.hex}}",
        "scrollbar.track.background": "{{colors.surface.default.hex}}",
        "editor.background": "{{colors.surface.default.hex}}",
        "editor.gutter.background": "{{colors.surface.default.hex}}",
        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editor.line_number": "{{colors.outline.default.hex}}",
        "editor.active_line_number": "{{colors.primary.default.hex}}",
        "editor.active_line.background": "{{colors.surface_container.default.hex}}",
        "editor.invisible": "{{colors.outline_variant.default.hex}}",
        "editor.wrap_guide": "{{colors.outline_variant.default.hex}}",
        "editor.active_wrap_guide": "{{colors.outline.default.hex}}",
        "editor.document_highlight.read_background": "{{colors.primary_container.default.hex}}",
        "editor.document_highlight.write_background": "{{colors.tertiary_container.default.hex}}",
        "search.match_background": "{{colors.tertiary_container.default.hex}}",
        "error": "{{colors.error.default.hex}}",
        "error.background": "{{colors.error_container.default.hex}}",
        "warning": "{{colors.secondary.default.hex}}",
        "info": "{{colors.primary.default.hex}}",
        "hint": "{{colors.outline.default.hex}}",
        "success": "{{colors.tertiary.default.hex}}",
        "created": "{{colors.tertiary.default.hex}}",
        "modified": "{{colors.secondary.default.hex}}",
        "deleted": "{{colors.error.default.hex}}",
        "conflict": "{{colors.error.default.hex}}",
        "hidden": "{{colors.outline.default.hex}}",
        "ignored": "{{colors.outline.default.hex}}",
        "terminal.background": "{{colors.surface.default.hex}}",
        "terminal.foreground": "{{colors.on_surface.default.hex}}",
        "terminal.ansi.black": "{{colors.surface_container_highest.default.hex}}",
        "terminal.ansi.red": "{{colors.ansi_1.default.hex}}",
        "terminal.ansi.green": "{{colors.ansi_2.default.hex}}",
        "terminal.ansi.yellow": "{{colors.ansi_3.default.hex}}",
        "terminal.ansi.blue": "{{colors.ansi_4.default.hex}}",
        "terminal.ansi.magenta": "{{colors.ansi_5.default.hex}}",
        "terminal.ansi.cyan": "{{colors.ansi_6.default.hex}}",
        "terminal.ansi.white": "{{colors.on_surface_variant.default.hex}}",
        "terminal.ansi.bright_black": "{{colors.outline.default.hex}}",
        "terminal.ansi.bright_red": "{{colors.ansi_9.default.hex}}",
        "terminal.ansi.bright_green": "{{colors.ansi_10.default.hex}}",
        "terminal.ansi.bright_yellow": "{{colors.ansi_11.default.hex}}",
        "terminal.ansi.bright_blue": "{{colors.ansi_12.default.hex}}",
        "terminal.ansi.bright_magenta": "{{colors.ansi_13.default.hex}}",
        "terminal.ansi.bright_cyan": "{{colors.ansi_14.default.hex}}",
        "terminal.ansi.bright_white": "{{colors.on_surface.default.hex}}",
        "syntax": {
          "comment": { "color": "{{colors.outline.default.hex}}" },
          "keyword": { "color": "{{colors.primary.default.hex}}" },
          "string": { "color": "{{colors.tertiary.default.hex}}" },
          "number": { "color": "{{colors.tertiary.default.hex}}" },
          "boolean": { "color": "{{colors.tertiary.default.hex}}" },
          "function": { "color": "{{colors.ansi_4.default.hex}}" },
          "type": { "color": "{{colors.secondary.default.hex}}" },
          "constant": { "color": "{{colors.tertiary.default.hex}}" },
          "property": { "color": "{{colors.on_surface.default.hex}}" },
          "variable": { "color": "{{colors.on_surface.default.hex}}" },
          "operator": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "punctuation": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "tag": { "color": "{{colors.primary.default.hex}}" },
          "attribute": { "color": "{{colors.secondary.default.hex}}" },
          "link_uri": { "color": "{{colors.primary.default.hex}}" },
          "link_text": { "color": "{{colors.primary.default.hex}}" }
        }
      }
    }
  ]
}
