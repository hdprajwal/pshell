<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generated by pshell; overwritten on every theme change.

  The only layout file this theme ships, and it exists for one word.

  walker's own themes/default/keybind.xml declares the hint box
  `orientation: vertical`, so every hint in the strip along the bottom draws
  its label chip on one line and the key that triggers it underneath -- two
  rows of text for what is one fact. GTK4 has no CSS property for a box's
  orientation, so style.css cannot reach it; a layout file is the only lever,
  and walker resolves theme files one at a time, falling back to its built-in
  default for any the theme omits. That is what makes shipping exactly this
  one file possible instead of forking all fifteen.

  Copied verbatim from walker 2.17.0's keybind.xml apart from three lines:
  orientation is horizontal, the box gains spacing 4 (Style.spacing.sm),
  and KeybindBind's `margin-top: 5` becomes valign center -- a top margin
  was the gap between two stacked rows and means nothing side by side.

  Every id is walker's. It looks these widgets up by id (KeybindButton,
  KeybindLabel, KeybindBind), so renaming one would leave the hint blank.

  The cost, stated plainly: this is a copy of an upstream file, and copies go
  stale. If a walker release changes keybind.xml, the theme keeps this one and
  whatever that release added is missing. style.css already carries that risk
  for the whole stylesheet; this adds a second, much smaller file to the same
  bet.
-->
<interface>
  <requires lib="gtk" version="4.0"></requires>
  <object class="GtkBox" id="Keybind">
    <style>
      <class name="keybind"></class>
    </style>
    <property name="orientation">horizontal</property>
    <property name="spacing">4</property>
    <child>
      <object class="GtkButton" id="KeybindButton">
        <style>
          <class name="keybind-button"></class>
        </style>
        <child>
          <object class="GtkLabel" id="KeybindLabel">
            <style>
              <class name="keybind-label"></class>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="KeybindBind">
        <property name="valign">center</property>
        <style>
          <class name="keybind-bind"></class>
        </style>
      </object>
    </child>
  </object>
</interface>
